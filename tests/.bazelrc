import %workspace%/../sanitizers/sanitizers.bazelrc

import %workspace%/../clang_tidy/clang_tidy.bazelrc

common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build

# Use LLVM toolchain for sanitizer configs (same as consuming modules)
build:asan          --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:ubsan         --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:lsan          --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:tsan          --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:asan_ubsan_lsan --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:tsan_ubsan    --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux

# Test --features=score_* directly, without the bool_flag layer.
build:feature_only_asan  --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:feature_only_asan  --features=score_asan
test:feature_only_asan   --test_env=ASAN_OPTIONS=exitcode=55:halt_on_error=1

build:feature_only_ubsan --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:feature_only_ubsan --features=score_ubsan_clang
test:feature_only_ubsan  --test_env=UBSAN_OPTIONS=exitcode=55:halt_on_error=1

build:feature_only_lsan  --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:feature_only_lsan  --features=score_lsan
test:feature_only_lsan   --test_env=LSAN_OPTIONS=exitcode=55

build:feature_only_tsan  --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:feature_only_tsan  --features=score_tsan
test:feature_only_tsan   --test_env=TSAN_OPTIONS=exitcode=55:halt_on_error=1

# Combination configs — parallel to asan_ubsan_lsan / tsan_ubsan but cc_feature only.
build:feature_only_asan_ubsan_lsan --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:feature_only_asan_ubsan_lsan --features=score_asan
build:feature_only_asan_ubsan_lsan --features=score_ubsan_clang
build:feature_only_asan_ubsan_lsan --features=score_lsan
build:feature_only_asan_ubsan_lsan --platform_suffix=fo_asan_ubsan_lsan
test:feature_only_asan_ubsan_lsan  --test_env=ASAN_OPTIONS=exitcode=55:halt_on_error=1
test:feature_only_asan_ubsan_lsan  --test_env=UBSAN_OPTIONS=exitcode=55:halt_on_error=1
test:feature_only_asan_ubsan_lsan  --test_env=LSAN_OPTIONS=exitcode=55

build:feature_only_tsan_ubsan --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:feature_only_tsan_ubsan --features=score_tsan
build:feature_only_tsan_ubsan --features=score_ubsan_clang
build:feature_only_tsan_ubsan --platform_suffix=fo_tsan_ubsan
test:feature_only_tsan_ubsan  --test_env=TSAN_OPTIONS=exitcode=55:halt_on_error=1
test:feature_only_tsan_ubsan  --test_env=UBSAN_OPTIONS=exitcode=55:halt_on_error=1

# GCC has no __has_feature(), so these configs only run positive + runtime tests.
build:feature_only_gcc_asan  --extra_toolchains=@score_gcc_x86_64_toolchain_fi//:x86_64-linux
build:feature_only_gcc_asan  --features=score_asan
test:feature_only_gcc_asan   --test_env=ASAN_OPTIONS=exitcode=55:halt_on_error=1

build:feature_only_gcc_ubsan --extra_toolchains=@score_gcc_x86_64_toolchain_fi//:x86_64-linux
build:feature_only_gcc_ubsan --features=score_ubsan_gcc
test:feature_only_gcc_ubsan  --test_env=UBSAN_OPTIONS=exitcode=55:halt_on_error=1

build:feature_only_gcc_lsan  --extra_toolchains=@score_gcc_x86_64_toolchain_fi//:x86_64-linux
build:feature_only_gcc_lsan  --features=score_lsan
test:feature_only_gcc_lsan   --test_env=LSAN_OPTIONS=exitcode=55

build:feature_only_gcc_tsan  --extra_toolchains=@score_gcc_x86_64_toolchain_fi//:x86_64-linux
build:feature_only_gcc_tsan  --features=score_tsan
test:feature_only_gcc_tsan   --test_env=TSAN_OPTIONS=exitcode=55:halt_on_error=1
